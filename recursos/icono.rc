// Recurso de icono del Organizador de carpetas.
// El ID 1 es el que usa el Explorador de Windows para el icono del .exe.
1 ICON "organizador.ico"

// Dialogos (historial, reglas, carpeta del movil)
#include "dialogos.rc"

// Version del ejecutable (lo que se ve en Propiedades del .exe)
1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS         0x40004
FILETYPE       0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FileNet"
            VALUE "FileDescription",  "FileNet - Organizador de carpetas"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "FileNet"
            VALUE "OriginalFilename", "Organizador de carpetas.exe"
            VALUE "ProductName",      "FileNet"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
