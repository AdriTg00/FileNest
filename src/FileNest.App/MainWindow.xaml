<Window x:Class="FileNest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileNest.App"
        Width="1060" Height="680" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown">

  <DockPanel>

    <Menu DockPanel.Dock="Top" Margin="8,4,8,0">
      <MenuItem Header="{x:Static local:Strings.Help}"
                Style="{StaticResource MenuTopItem}"
                ItemContainerStyle="{StaticResource MenuSubItem}">
        <MenuItem Header="{x:Static local:Strings.Manual}" Click="OnManual" />
        <Separator />
        <MenuItem Header="{x:Static local:Strings.CheckUpdates}" Click="OnCheckUpdates" />
        <Separator />
        <MenuItem Header="{x:Static local:Strings.About}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <Grid Margin="12,6,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================================================= carpeta y botones -->
        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{x:Static local:Strings.Folder}"
                   VerticalAlignment="Center" Margin="0,0,10,0" />

        <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True" />
        <Button Grid.Column="2" x:Name="ChooseButton" Content="{x:Static local:Strings.ChooseFolder}"
                Margin="8,0,0,0" Click="OnChooseFolder" />
        <Button Grid.Column="3" x:Name="PhoneButton" Content="{x:Static local:Strings.Phone}"
                Margin="8,0,0,0" MinWidth="80" Click="OnPhone" />
        <Button Grid.Column="4" x:Name="RulesButton" Content="{x:Static local:Strings.Rules}"
                Margin="8,0,0,0" MinWidth="80" Click="OnRules" />
        <Button Grid.Column="5" x:Name="DuplicatesButton" Content="{x:Static local:Strings.Duplicates}"
                Margin="8,0,0,0" MinWidth="104" Click="OnDuplicates" />
        <Button Grid.Column="6" x:Name="ThemeButton" Content="{x:Static local:Strings.ThemeLight}"
                Margin="8,0,0,0" MinWidth="124" Click="OnTheme" />
      </Grid>

      <!-- ========================================================= opciones -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
        <CheckBox x:Name="ByDateCheck" Content="{x:Static local:Strings.GroupByDate}"
                  Click="OnOptionsChanged" />
        <CheckBox x:Name="RecursiveCheck" Content="{x:Static local:Strings.IncludeSubfolders}"
                  Margin="28,0,0,0" Click="OnOptionsChanged" />
        <CheckBox x:Name="WatchCheck" Content="{x:Static local:Strings.Watch}"
                  Margin="28,0,0,0" Click="OnWatchToggled" />
      </StackPanel>

      <!-- ============================================================ lista -->
      <ListView Grid.Row="2" x:Name="FileList" Margin="0,12,0,0">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource ErrorFg}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>

        <ListView.View>
          <GridView>
            <GridViewColumn Width="30">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static local:Strings.ColFile}" Width="235" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="{x:Static local:Strings.ColSize}" Width="90" DisplayMemberBinding="{Binding Size}" />
            <GridViewColumn Header="{x:Static local:Strings.ColCategory}" Width="120" DisplayMemberBinding="{Binding Category}" />
            <GridViewColumn Header="{x:Static local:Strings.ColTarget}" Width="330" DisplayMemberBinding="{Binding Target}" />
            <GridViewColumn Header="{x:Static local:Strings.ColStatus}" Width="90" DisplayMemberBinding="{Binding Status}" />
          </GridView>
        </ListView.View>
      </ListView>

      <!-- ========================================================== acciones -->
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" x:Name="SimulateButton" Content="{x:Static local:Strings.Simulate}"
                Click="OnSimulate" />
        <Button Grid.Column="1" x:Name="ApplyButton" Content="{x:Static local:Strings.Apply}"
                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnApply" />
        <Button Grid.Column="2" x:Name="UndoButton" Content="{x:Static local:Strings.Undo}"
                Margin="8,0,0,0" Click="OnUndo" />
        <Button Grid.Column="3" x:Name="OpenButton" Content="{x:Static local:Strings.OpenFolder}"
                Margin="8,0,0,0" Click="OnOpenFolder" />

        <ProgressBar Grid.Column="4" x:Name="Progress" Margin="16,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" x:Name="ProgressText" Margin="10,0,0,0" MinWidth="92"
                   VerticalAlignment="Center" Foreground="{DynamicResource MutedFg}" />
      </Grid>

      <!-- =========================================================== estado -->
      <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedFg}" />
    </Grid>
  </DockPanel>
</Window>
