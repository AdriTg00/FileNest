<Window x:Class="FileNest.App.Dialogs.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileNest.App"
        Width="840" Height="640" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="13">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="SummaryText" TextWrapping="Wrap" />

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedFg}" />
        <ItemsControl x:Name="GroupsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource PanelBg}"
                      BorderBrush="{DynamicResource BorderBr}"
                      BorderThickness="1" CornerRadius="8"
                      Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                    VerticalAlignment="Top" Margin="0,3,10,0"
                                    Click="OnFileToggled" />
                          <TextBlock Grid.Column="1" Text="{Binding Display}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Grid.Column="0" x:Name="Progress" Height="18" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="ProgressText" Margin="10,0,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource MutedFg}" MinWidth="120" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" x:Name="HintText" VerticalAlignment="Center"
                 TextWrapping="Wrap" Foreground="{DynamicResource MutedFg}" FontSize="12" />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="MoveButton" Content="{x:Static local:Strings.MoveToDuplicates}"
                Style="{StaticResource PrimaryButton}" MinWidth="190" Click="OnMove" />
        <Button Content="{x:Static local:Strings.Close}" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
