<Window x:Class="FileNest.App.Dialogs.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileNest.App"
        Width="400" Height="330" MinWidth="340" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="13">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox x:Name="LogList" Grid.Row="0" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{x:Static local:Strings.Undo}" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="OnAccept" />
      <Button Content="{x:Static local:Strings.Cancel}" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
