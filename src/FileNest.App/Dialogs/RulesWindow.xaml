<Window x:Class="FileNest.App.Dialogs.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileNest.App"
        Width="600" Height="500" MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="13">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- patron + carpeta -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="{x:Static local:Strings.ExtensionLabel}"
                 VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="PatternBox" Margin="8,0,16,0" />
      <TextBlock Grid.Column="2" Text="{x:Static local:Strings.FolderLabel}"
                 VerticalAlignment="Center" />
      <TextBox Grid.Column="3" x:Name="TargetBox" Margin="8,0,0,0" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="AddButton" Content="{x:Static local:Strings.Add}" Click="OnAdd" />
      <Button x:Name="RemoveButton" Content="{x:Static local:Strings.Remove}" Margin="8,0,0,0" Click="OnRemove" />
      <Button x:Name="UpButton" Content="{x:Static local:Strings.MoveUp}" Margin="20,0,0,0" MinWidth="76" Click="OnUp" />
      <Button x:Name="DownButton" Content="{x:Static local:Strings.MoveDown}" Margin="8,0,0,0" MinWidth="76" Click="OnDown" />
    </StackPanel>

    <ListBox x:Name="RulesList" Grid.Row="2" Margin="0,12,0,0" />

    <TextBlock Grid.Row="3" Text="{x:Static local:Strings.RulesHint}" Margin="0,10,0,0"
               TextWrapping="Wrap" Foreground="{DynamicResource MutedFg}" FontSize="12" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{x:Static local:Strings.Save}" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="OnSave" />
      <Button Content="{x:Static local:Strings.Cancel}" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
