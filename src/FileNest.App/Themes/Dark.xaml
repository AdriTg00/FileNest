<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tema OSCURO -->

  <Color x:Key="WindowBgColor">#FF16181C</Color>
  <Color x:Key="PanelBgColor">#FF202329</Color>
  <Color x:Key="Panel2BgColor">#FF2C3037</Color>
  <Color x:Key="TextFgColor">#FFE9EDF2</Color>
  <Color x:Key="MutedFgColor">#FF96A0AC</Color>
  <Color x:Key="BorderBrColor">#FF3C424A</Color>
  <Color x:Key="ButtonBgColor">#FF282C32</Color>
  <Color x:Key="ButtonHoverBgColor">#FF383E46</Color>
  <Color x:Key="ButtonFgColor">#FFECEEF3</Color>
  <Color x:Key="AccentBrColor">#FF4084FF</Color>
  <Color x:Key="AccentFgColor">#FFFFFFFF</Color>
  <Color x:Key="OkFgColor">#FF5ED68C</Color>
  <Color x:Key="ErrorFgColor">#FFFF6E6E</Color>
  <Color x:Key="SelectionBgColor">#FF2B3A52</Color>
  <Color x:Key="ScrollThumbBgColor">#FF4A515A</Color>
  <Color x:Key="ScrollThumbHoverBgColor">#FF5F6873</Color>

  <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
  <SolidColorBrush x:Key="PanelBg" Color="{StaticResource PanelBgColor}" />
  <SolidColorBrush x:Key="Panel2Bg" Color="{StaticResource Panel2BgColor}" />
  <SolidColorBrush x:Key="TextFg" Color="{StaticResource TextFgColor}" />
  <SolidColorBrush x:Key="MutedFg" Color="{StaticResource MutedFgColor}" />
  <SolidColorBrush x:Key="BorderBr" Color="{StaticResource BorderBrColor}" />
  <SolidColorBrush x:Key="ButtonBg" Color="{StaticResource ButtonBgColor}" />
  <SolidColorBrush x:Key="ButtonHoverBg" Color="{StaticResource ButtonHoverBgColor}" />
  <SolidColorBrush x:Key="ButtonFg" Color="{StaticResource ButtonFgColor}" />
  <SolidColorBrush x:Key="AccentBr" Color="{StaticResource AccentBrColor}" />
  <SolidColorBrush x:Key="AccentFg" Color="{StaticResource AccentFgColor}" />
  <SolidColorBrush x:Key="OkFg" Color="{StaticResource OkFgColor}" />
  <SolidColorBrush x:Key="ErrorFg" Color="{StaticResource ErrorFgColor}" />
  <SolidColorBrush x:Key="SelectionBg" Color="{StaticResource SelectionBgColor}" />
  <SolidColorBrush x:Key="ScrollThumbBg" Color="{StaticResource ScrollThumbBgColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBg" Color="{StaticResource ScrollThumbHoverBgColor}" />

</ResourceDictionary>
